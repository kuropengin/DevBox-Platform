# DevBox Platform インストール設定
# このファイルを install.env にコピーして編集してください
# 使い方: sudo bash scripts/install.sh
#   （install.env は自動的に読み込まれます）

# ─── 必須設定 ──────────────────────────────────────────────────────────────────

# サーバーの IP またはドメイン
DEVBOX_DOMAIN=192.168.11.64

# ─── Authentik 設定 ────────────────────────────────────────────────────────────

# Authentik 管理者パスワード（省略時は自動生成して /etc/devbox/authentik.env に保存）
# AUTHENTIK_ADMIN_PASSWORD=

# Authentik のセットアップをスキップする場合: yes
# SKIP_AUTHENTIK=yes
