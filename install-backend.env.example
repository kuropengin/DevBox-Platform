# DevBox Platform - backend サーバー インストール設定
# このファイルを install-backend.env にコピーして編集してください
# 使い方: sudo -E bash scripts/backend/install-backend.sh
#   （install-backend.env は自動的に読み込まれます）

# ─── 必須設定 ──────────────────────────────────────────────────────────────────

# front サーバーの IP または CIDR。backend の内部ポート（80）は
# ここで指定した送信元からの通信のみ firewalld で許可されます。
# 未設定の場合、80 番ポートは一切開放されません（安全側デフォルト）。
#
# front と同一ホストに同居させる場合（1台構成）は 127.0.0.1 を指定してください。
FRONT_ALLOWED_SOURCE=10.0.1.5

# 複数の front からアクセスさせたい場合や、front 側のサブネット全体を
# 許可したい場合は CIDR で指定できます。
# FRONT_ALLOWED_SOURCE=10.0.1.0/24

# front↔backend間の共有シークレット（必須）。install-front.sh の実行結果
# （または front の /etc/devbox/platform.conf の DEVBOX_INTERNAL_TOKEN）に
# 表示された値をそのままコピーしてください。
#
# firewalld による送信元 IP 制限は唯一の防御ではなく、backend の nginx は
# このトークンが付与されたリクエストしか処理しません（多層防御）。未設定
# だと install-backend.sh はエラーで停止します。
DEVBOX_INTERNAL_TOKEN=

# ─── ユーザーディレクトリの配置先（任意） ──────────────────────────────────────
# ユーザーディレクトリ（/home/<username> 相当）の作成先ベースディレクトリ。
# マウントした別ボリュームにユーザーディレクトリを置きたい場合に指定
# してください（そのボリュームは事前にマウント済みであること）。
# 未設定時は従来通り /home 配下に作成されます。
# USER_HOME_BASE=/mnt/userdata

# ─── Headroom（LLMプロキシ）設定 ───────────────────────────────────────────────
# ユーザーの Claude Code CLI は Anthropic に直接ではなく、front で動く
# Headroom を経由します（詳細は README の「Headroom」セクション参照）。
# 未設定でも install-backend.sh 自体は失敗しませんが、Headroom 未設定の
# まま adduser-backend.sh を実行したユーザーは Claude Code が使えません。

# front の Headroom エンドポイント。install-front.sh の完了メッセージに
# 表示された値をコピーしてください（例: http://10.0.1.5:8787）。
HEADROOM_BASE_URL=http://10.0.1.5:8787

# front↔Headroomクライアント間の共有シークレット。install-front.sh の
# 実行結果（または front の /etc/devbox/platform.conf の
# DEVBOX_HEADROOM_TOKEN）に表示された値をそのままコピーしてください。
DEVBOX_HEADROOM_TOKEN=
