# DevBox Platform - front サーバー インストール設定
# このファイルを install-front.env にコピーして編集してください
# 使い方: sudo -E bash scripts/install-front.sh
#   （install-front.env は自動的に読み込まれます）

# ─── 必須設定 ──────────────────────────────────────────────────────────────────

# front サーバーの IP またはドメイン
# IP アドレスを指定した場合、LemonLDAP::NG の Cookie ドメイン制約
# （数字だけのラベルは不可）のため、install-front.sh が自動的に
# 192-168-11-64.sslip.io のような sslip.io 経由のホスト名に変換します。
# sslip.io はインターネット経由の公開 DNS のため、完全に閉域網の場合は
# 別途ホスト名を用意して DEVBOX_DOMAIN に指定してください。
DEVBOX_DOMAIN=192.168.11.64

# ─── LLDAP / LemonLDAP::NG 設定 ────────────────────────────────────────────────

# LLDAP 管理者パスワード（省略時は自動生成して /etc/devbox/lldap.env に保存）
# LLDAP_ADMIN_PASSWORD=

# LLDAP / LemonLDAP::NG のセットアップをスキップする場合: yes
# SKIP_LLDAP=yes
