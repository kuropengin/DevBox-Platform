# DevBox Platform - front サーバー インストール設定
# このファイルを install-front.env にコピーして編集してください
# 使い方: sudo -E bash scripts/front/install-front.sh
#   （install-front.env は自動的に読み込まれます）

# ─── 必須設定 ──────────────────────────────────────────────────────────────────

# front サーバーの IP またはドメイン
# IP アドレスを指定した場合、LemonLDAP::NG の Cookie ドメイン制約
# （数字だけのラベルは不可）のため、install-front.sh が自動的に
# 192-168-11-64.sslip.io のような sslip.io 経由のホスト名に変換します。
# sslip.io はインターネット経由の公開 DNS のため、完全に閉域網の場合は
# 別途ホスト名を用意して DEVBOX_DOMAIN に指定してください。
DEVBOX_DOMAIN=192.168.11.64

# Headroom（LLMプロキシ）が Anthropic に認証するための実 API キー（必須）。
# ユーザー側は個別に API キーを持たず、ここで指定したキーだけを front が
# 保持します。未設定だと install-front.sh はエラーで停止します。
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# ─── ユーザーディレクトリの配置先（任意） ──────────────────────────────────────
# ポータルが VS Code 初回アクセス時に自動で開く ~/workspace のパス計算に
# 使います。backend側の install-backend.env で USER_HOME_BASE を指定した
# 場合は、ここにも同じ値を指定してください（一致しないと初回オープンの
# パスが正しく解決できません）。未設定時は従来通り /home として扱われます。
# USER_HOME_BASE=/mnt/userdata

# ─── LLDAP / LemonLDAP::NG 設定 ────────────────────────────────────────────────

# LLDAP 管理者パスワード（省略時は自動生成して /etc/devbox/lldap.env に保存）
# LLDAP_ADMIN_PASSWORD=

# LLDAP / LemonLDAP::NG のセットアップをスキップする場合: yes
# SKIP_LLDAP=yes

# ─── Headroom（LLMプロキシ）設定 ───────────────────────────────────────────────

# backend サーバーの IP または CIDR。Headroom の内部ポート（8787）は
# ここで指定した送信元からの通信のみ firewalld で許可されます
# （カンマ区切りで複数backend可）。未設定の場合、8787番ポートは
# 一切開放されません（安全側デフォルト）。
BACKEND_ALLOWED_SOURCES=10.0.2.11,10.0.2.12

# front と同一ホストに同居させる場合（1台構成）は 127.0.0.1 を指定してください。
# BACKEND_ALLOWED_SOURCES=127.0.0.1
