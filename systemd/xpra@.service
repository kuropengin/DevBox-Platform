[Unit]
Description=Xpra HTML5 Desktop for %i
PartOf=devbox@%i.target
After=devbox@%i.target

[Service]
Type=simple
User=%i
Group=%i
EnvironmentFile=/etc/devbox/users/%i.conf
WorkingDirectory=__USER_HOME_BASE__/%i
Environment=HOME=__USER_HOME_BASE__/%i
Environment=XDG_RUNTIME_DIR=/run/user/%U
ExecStartPre=/bin/bash -c 'mkdir -p __USER_HOME_BASE__/%i/.xpra __USER_HOME_BASE__/%i/.config/xpra'
ExecStart=/bin/bash -c '\
  exec /usr/bin/xpra start :${XPRA_DISPLAY} \
    --bind-tcp=127.0.0.1:${XPRA_PORT} \
    --html=on \
    --start=xfce4-session \
    --exit-with-children=no \
    --daemon=no \
    --mdns=no \
    --webcam=no \
    --notifications=no \
    --speaker=no \
    --microphone=no \
    --xvfb=/usr/bin/Xvfb \
    --socket-dir=__USER_HOME_BASE__/%i/.xpra'
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s

# リソース制限はドロップイン /etc/systemd/system/xpra@username.service.d/resources.conf で設定
# 上記の二重アンダースコア囲みの文字列は install-backend.sh がインストール
# 時に USER_HOME_BASE（既定 /home）で置換するプレースホルダー
# （詳細は vscode@.service 参照）。

[Install]
WantedBy=devbox@%i.target
