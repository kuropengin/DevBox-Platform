[Unit]
Description=VS Code serve-web for %i
PartOf=devbox@%i.target
After=devbox@%i.target

[Service]
Type=simple
User=%i
Group=%i
EnvironmentFile=/etc/devbox/users/%i.conf
WorkingDirectory=/home/%i
Environment=HOME=/home/%i
Environment=XDG_RUNTIME_DIR=/run/user/%U
ExecStartPre=/bin/bash -c 'mkdir -p /home/%i/.vscode/cli-data /home/%i/.vscode/server-data'
ExecStart=/usr/bin/code serve-web \
    --host 127.0.0.1 \
    --port $VSCODE_PORT \
    --without-connection-token \
    --accept-server-license-terms \
    --server-base-path /%i/vscode \
    --cli-data-dir /home/%i/.vscode/cli-data \
    --server-data-dir /home/%i/.vscode/server-data
Restart=on-failure
RestartSec=5s
TimeoutStopSec=10s

# リソース制限はドロップイン /etc/systemd/system/vscode@username.service.d/resources.conf で設定

[Install]
WantedBy=devbox@%i.target
